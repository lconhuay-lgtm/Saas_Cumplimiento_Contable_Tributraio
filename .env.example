# Copiar este archivo a .env y ajustar si hace falta.
# Los valores por defecto ya funcionan para levantar todo con docker-compose.

# Base de datos
POSTGRES_USER=buzon
POSTGRES_PASSWORD=buzon_dev_password
POSTGRES_DB=buzon_saas
DATABASE_URL=postgresql://buzon:buzon_dev_password@postgres:5432/buzon_saas

# Redis (cola de trabajos, Fase 1)
REDIS_URL=redis://redis:6379/0

# "dev" (default) o "prod". En prod, JWT_SECRET_KEY se vuelve obligatorio --
# el backend no arranca sin el (fix Fase R3, ver security.py).
ENTORNO=dev

# Origenes permitidos por CORS, separados por coma -- el dominio real del
# tablero en produccion (ej. https://app.tudominio.com). El default de abajo
# solo sirve para desarrollo local (fix Fase R3, ver main.py).
ALLOWED_ORIGINS=http://localhost:3000

# Autenticación. JWT_SECRET_KEY: generar con
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# y NUNCA reusar el valor de ejemplo de abajo en produccion.
JWT_SECRET_KEY=cambiar-esto-por-un-valor-aleatorio-largo-antes-de-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Cifrado de credenciales SOL. Backend y worker son procesos distintos y
# DEBEN compartir esta clave (si no, el worker no puede descifrar lo que el
# backend cifro). Generarla una vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# y pegarla aqui. Ver README para como se reemplaza por KMS real en produccion.
CREDENCIALES_FERNET_KEY=

# Automatización SUNAT (core_scraper)
SUNAT_HEADLESS=true

# Rate limiting de consultas SUNAT (Fase 1 semana 5)
SUNAT_MAX_CONSULTAS_CONCURRENTES=3
SUNAT_SEGUNDOS_ENTRE_CONSULTAS_MISMO_RUC=60

# ---- Fase 2 ----

# Tablero web: URL del backend que usa el NAVEGADOR del usuario (no el
# nombre del servicio de Docker -- el navegador corre fuera de la red
# interna de Compose).
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL publica del tablero -- la usa el BACKEND (no el navegador) para armar
# links dentro de correos (ej. el link de invitacion de equipo). En
# produccion, cambiar al dominio real del tablero.
FRONTEND_URL=http://localhost:3000

# Chequeo automatico, DOS veces al dia: hora UTC en la que arranca cada
# paso (Peru = UTC-5 todo el ano, sin horario de verano).
# Tanda 1: 16:00 UTC = 11:00 Peru (encola las consultas), resumen ~2h
# despues a las 18:00 UTC = 13:00 Peru.
# Tanda 2: 00:30 UTC = 19:30 Peru (encola las consultas), resumen ~2h
# despues a las 02:30 UTC = 21:30 Peru.
# CHEQUEO1_HORA_UTC/CHEQUEO1_MINUTO_UTC/CHEQUEO2_HORA_UTC/CHEQUEO2_MINUTO_UTC
# ahora son solo el fallback de la PRIMERA instalacion (fila "global" de
# ConfiguracionSistema todavia no existe) -- una vez que el sistema arranco
# una vez, el horario real de los chequeos se edita desde el tablero
# (Panel maestro > horario de consulta masiva), no aqui.
CHEQUEO1_HORA_UTC=16
CHEQUEO1_MINUTO_UTC=0
RESUMEN1_HORA_UTC=18
RESUMEN1_MINUTO_UTC=0
CHEQUEO2_HORA_UTC=0
CHEQUEO2_MINUTO_UTC=30
RESUMEN2_HORA_UTC=2
RESUMEN2_MINUTO_UTC=30

# Correo de resumen diario. Si SMTP_HOST queda vacio, el "correo" se guarda
# como archivo de texto en sunat_data/emails_dev/ en vez de enviarse de
# verdad (modo prueba) -- util para probar sin una cuenta de correo real.
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo,
# SMTP_PASSWORD=una "contrasena de aplicacion" (no tu contrasena normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-responder@buzonsaas.local

# ---- Visor de PDF (mejora post-Fase 2) ----

# Cuantos documentos como maximo descarga el worker en UNA sola consulta --
# limite de seguridad para que una empresa con muchos mensajes nuevos de
# golpe no alargue la sesion contra SUNAT indefinidamente. El resto queda
# pendiente para la proxima consulta (el mensaje en si se guarda igual,
# solo el PDF se reintenta despues).
SUNAT_MAX_DESCARGAS_POR_CORRIDA=10

# "local" (default) guarda los PDF en sunat_data/documentos/ -- cero
# configuracion extra, para desarrollo. "s3" los sube a un bucket
# compatible con S3 (pensado para Cloudflare R2 en produccion: sin costo
# de egreso, 10GB gratis al mes). Ver README para como migrar de uno a otro.
ALMACENAMIENTO_MODO=local

# ---- Fase R7 (higiene de datos) ----

# Dias que se conservan las capturas de diagnostico (sunat_data/logs/) y los
# correos de modo prueba (sunat_data/emails_dev/) antes de borrarse solos --
# corre a diario via scheduler (04:30 UTC) y a mano con
# POST /admin/limpieza-diagnosticos. NUNCA se aplica a sunat_data/documentos/
# (PDFs reales de clientes), esos se conservan siempre. Solo tiene efecto con
# ALMACENAMIENTO_MODO=local.
RETENCION_DIAGNOSTICOS_DIAS=45

# Solo hacen falta si ALMACENAMIENTO_MODO=s3.
S3_BUCKET=
# Vacio = AWS S3 real. Con Cloudflare R2: https://<id-de-cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# ---- Fase 3: chequeo canario (confiabilidad y observabilidad) ----

# Cada cuantos minutos corre el login de prueba contra la cuenta canario
# (la que se marque con "es_canario" desde el tablero). No hace nada si
# ninguna empresa esta marcada como canario.
CANARIO_INTERVALO_MIN=30

# A que correo llega la alerta ("el canario esta fallando") y el aviso de
# recuperacion -- es un correo operativo para el equipo, no para un tenant.
ALERTA_CANARIO_EMAIL=brianconhuay@gmail.com

# Cuantos chequeos canario seguidos tienen que fallar antes de mandar la
# alerta (mas de 1 para no disparar el correo por un timeout suelto).
CANARIO_FALLOS_CONSECUTIVOS_PARA_ALERTA=2
